<?php

/**
 * @file
 * Contains diocesan_directory.module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\diocesan_directory\Hook\DiocesanDirectoryHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function diocesan_directory_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(DiocesanDirectoryHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 *
 * @phpstan-return array<string, mixed>
 */
#[LegacyHook]
function diocesan_directory_theme(): array {
  return \Drupal::service(DiocesanDirectoryHooks::class)->theme();
}

/**
 * Implements hook_theme_suggestions_HOOK().
 *
 * @phpstan-param array<string, mixed> $variables
 * @phpstan-return string[]
 */
#[LegacyHook]
function diocesan_directory_theme_suggestions_directory(array $variables): array {
  return \Drupal::service(DiocesanDirectoryHooks::class)->themeSuggestionsDirectory($variables);
}

/**
 * Implements hook_form_alter().
 *
 * @phpstan-param array<string, mixed> $form
 */
#[LegacyHook]
function diocesan_directory_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service(DiocesanDirectoryHooks::class)->formAlter($form, $form_state, $form_id);
}
